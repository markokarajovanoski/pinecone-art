# Copy this file to .env.local and fill it in from Supabase → Project Settings → API Keys.
# Both values are public (they ship to the browser). Row-level security in the database
# is what keeps orders and drafts private.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
